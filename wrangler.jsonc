// Worker de Cloudflare: sirve el sitio prerenderizado de dist/ y corre el panel de Keystatic.
// Secrets del panel (cargalos en el Worker, no acá): KEYSTATIC_GITHUB_CLIENT_ID,
// KEYSTATIC_GITHUB_CLIENT_SECRET y KEYSTATIC_SECRET.
{
  "name": "del-rock-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"]
}
