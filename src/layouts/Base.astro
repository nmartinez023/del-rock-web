---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
  tipo?: 'website' | 'article';
}

const {
  titulo,
  descripcion = 'Rock nacional, todos los días. Noticias, agenda de shows y coberturas.',
  imagen = '/logo.png',
  tipo = 'website',
} = Astro.props;

const tituloCompleto = titulo ? `${titulo} | Del Rock Arg` : 'Del Rock Arg | Rock nacional, todos los días';
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagenAbs = new URL(imagen, Astro.site);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="theme-color" content="#0b0b0d" />
    <!-- Cuándo se compiló esta versión: sirve para saber si ya se publicó un cambio. -->
    <meta name="build" content={new Date().toISOString()} />

    <meta property="og:site_name" content="Del Rock Arg" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={titulo ?? tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenAbs} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@400;500;600;700;800&family=Permanent+Marker&display=swap"
    />
    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    background: var(--azul);
    color: var(--bg);
    padding: 10px 16px;
    font-weight: 700;
  }
  .saltar:focus {
    top: 16px;
  }
</style>
