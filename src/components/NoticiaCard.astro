---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Titular from './Titular.astro';
import { TIPOS, hace, type Noticia } from '../lib/util';

interface Props {
  noticia: Noticia;
  variante?: 'grande' | 'lista' | 'grilla';
  prioridad?: boolean;
}

const { noticia, variante = 'grilla', prioridad = false } = Astro.props;
const { data } = noticia;
const banda = data.banda ? await getEntry(data.banda) : undefined;
const kicker = banda?.data.nombre ?? data.destacado ?? TIPOS[data.tipo];
const href = `/noticias/${noticia.id}/`;
const anchos = { grande: 1280, lista: 240, grilla: 640 };
---

<article class={`card card--${variante}`}>
  <a href={href} class="foto" tabindex="-1" aria-hidden="true">
    <Image
      src={data.portada}
      alt=""
      width={anchos[variante]}
      widths={variante === 'lista' ? undefined : [anchos[variante] / 2, anchos[variante]]}
      sizes={variante === 'grande' ? '(max-width: 960px) 100vw, 840px' : variante === 'grilla' ? '(max-width: 700px) 100vw, 400px' : undefined}
      loading={prioridad ? 'eager' : 'lazy'}
      fetchpriority={prioridad ? 'high' : undefined}
    />
    {variante !== 'lista' && <span class:list={['chip', { 'chip--azul': data.tipo === 'cobertura' }]}>{TIPOS[data.tipo]}</span>}
  </a>
  <div class="texto">
    {variante === 'grande' ? <span class="kicker kicker--linea">{kicker}</span> : <span class="kicker">{kicker}</span>}
    {
      variante === 'grande' ? (
        <h2 class="d titulo">
          <a href={href}><Titular titulo={data.titulo} destacado={data.destacado} /></a>
        </h2>
      ) : (
        <h3 class="titulo">
          <a href={href}>{data.titulo}</a>
        </h3>
      )
    }
    {variante === 'grande' && data.bajada && <p class="bajada">{data.bajada}</p>}
    {variante !== 'lista' && <p class="meta">{hace(data.fecha)}</p>}
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .foto {
    position: relative;
    display: block;
    border-radius: 3px;
  }
  .chip {
    position: absolute;
    top: 12px;
    left: 12px;
  }
  .texto {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .titulo {
    margin: 0;
  }
  .meta {
    margin: 0;
  }

  .card--grilla .foto {
    aspect-ratio: 4 / 3;
  }
  .card--grilla .titulo {
    font-size: 21px;
    line-height: 1.25;
    font-weight: 700;
  }
  .card--grilla:hover .foto img {
    transform: scale(1.03);
  }
  .foto img {
    transition: transform 0.4s ease;
  }

  .card--grande {
    gap: 18px;
  }
  .card--grande .foto {
    aspect-ratio: 16 / 9;
    border-radius: 4px;
  }
  .card--grande .titulo {
    font-size: clamp(40px, 6vw, 68px);
    line-height: 0.98;
  }
  .card--grande .bajada {
    margin: 0;
    font-size: 19px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 62ch;
  }

  .card--lista {
    flex-direction: row;
    gap: 16px;
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
  }
  .card--lista .foto {
    flex: 0 0 112px;
    width: 112px;
    height: 84px;
  }
  .card--lista .titulo {
    font-size: 17px;
    line-height: 1.3;
    font-weight: 600;
  }
  .card--lista .kicker {
    font-size: 12px;
  }
</style>
