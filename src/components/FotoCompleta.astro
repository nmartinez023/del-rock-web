---
// Foto de un evento entera (sin recortar) dentro de un contenedor de forma fija (cuadrado, 4:3…).
// Lo que sobra arriba/abajo o a los costados se rellena con la misma foto ampliada y difuminada,
// así el fondo toma sus colores. Es la misma imagen: el navegador la baja una sola vez.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  imagen: { tipo: 'local'; src: ImageMetadata } | { tipo: 'remota'; src: string };
  alt: string;
  ancho: number;
  anchos?: number[];
  sizes?: string;
  eager?: boolean;
}

const { imagen, alt, ancho, anchos, sizes, eager = false } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
---

<span class="foto-completa">
  {
    imagen.tipo === 'local' ? (
      <>
        <Image class="fondo" src={imagen.src} alt="" width={64} loading={loading} aria-hidden="true" />
        <Image class="frente" src={imagen.src} alt={alt} width={ancho} widths={anchos} sizes={sizes} loading={loading} />
      </>
    ) : (
      <>
        <img class="fondo" src={imagen.src} alt="" aria-hidden="true" loading={loading} decoding="async" />
        <img class="frente" src={imagen.src} alt={alt} width={ancho} height={ancho} loading={loading} decoding="async" />
      </>
    )
  }
</span>

<style>
  .foto-completa {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #1b1d22;
  }
  .fondo {
    position: absolute;
    inset: -12%;
    width: 124%;
    height: 124%;
    object-fit: cover;
    filter: blur(22px) saturate(1.3) brightness(0.8);
  }
  .frente {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
