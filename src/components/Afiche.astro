---
import { diaMes, type Fecha } from '../lib/util';

interface Props {
  fecha: Fecha;
  i?: number;
}

const { fecha, i = 0 } = Astro.props;
const { data } = fecha;
const { dia, mes } = diaMes(data.fecha);
const rot = [-1.6, 1.2, -0.8, 1.8, -1.2, 0.9][i % 6];
const href = data.entradas ?? (data.banda ? `/bandas/${data.banda.id}/` : undefined);
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  rel={data.entradas ? 'noopener' : undefined}
  class="afiche"
  style={`--rot:${rot}deg`}
  data-provincia={data.provincia}
  data-fecha={data.fecha.toISOString().slice(0, 10)}
>
  <span class="cinta-adhesiva" aria-hidden="true"></span>
  <time datetime={data.fecha.toISOString().slice(0, 10)} class="cuando">
    <span class="d dia">{dia}</span>
    <span class="d mes">{mes}</span>
  </time>
  <span class="d quien">{data.titulo}</span>
  <span class="donde">{data.venue}, {data.ciudad}{data.hora && ` · ${data.hora} h`}</span>
  {
    data.entradas && (
      <span class="entradas">
        <span>Entradas</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </span>
    )
  }
</Tag>

<style>
  .afiche {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--papel);
    color: var(--tinta);
    padding: 28px 22px 22px;
    transform: rotate(var(--rot));
    box-shadow: 0 10px 24px rgb(0 0 0 / 0.45);
    transition: transform 0.15s ease;
  }
  a.afiche:hover {
    color: var(--tinta);
    transform: rotate(0deg) translateY(-4px);
  }
  .cinta-adhesiva {
    position: absolute;
    top: -12px;
    left: 50%;
    width: 96px;
    height: 26px;
    margin-left: -48px;
    background: rgb(222 212 182 / 0.8);
    transform: rotate(-4deg);
  }
  .cuando {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .dia {
    font-size: 76px;
    line-height: 0.9;
  }
  .mes {
    font-size: 26px;
    color: #2f6ea6; /* azul de marca oscurecido para contraste sobre papel */
  }
  .quien {
    font-size: 30px;
    line-height: 1.05;
    margin-top: 14px;
  }
  .donde {
    font-size: 15px;
    margin-top: 6px;
    color: #3a3a3a;
  }
  .entradas {
    margin-top: 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 2px dashed #b7b0a2;
    padding-top: 12px;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
