---
import { Image } from 'astro:assets';
import { bandasDe, diaMes, imagenDeFecha, precioTexto, rutaDeFecha, slugTag, tituloConCiudad, type Fecha } from '../lib/util';

interface Props {
  fecha: Fecha;
  i?: number;
}

const { fecha, i = 0 } = Astro.props;
const { data } = fecha;
const { dia, mes } = diaMes(data.fecha);
const rot = [-1.6, 1.2, -0.8, 1.8, -1.2, 0.9][i % 6];
const href = await rutaDeFecha(fecha);
const imagen = imagenDeFecha(fecha, href);
const titulo = tituloConCiudad(fecha);
const precio = precioTexto(data.precioDesde);

// Lineup: en un festival, todas las bandas; en un show, las que no figuran ya en el título.
const nombres = (await bandasDe(fecha)).map((b) => b.data.nombre);
const enTitulo = slugTag(data.titulo);
// Más de 3 bandas es un festival: el afiche no las lista.
const lineup = nombres.length > 3 ? [] : data.tipo === 'festival' ? nombres : nombres.filter((n) => !enTitulo.includes(slugTag(n)));
---

<a
  href={href}
  class="afiche"
  style={`--rot:${rot}deg`}
  data-provincia={data.provincia}
  data-fecha={data.fecha.toISOString().slice(0, 10)}
>
  <span class="cinta-adhesiva" aria-hidden="true"></span>
  {
    imagen && (
      <span class="foto foto-afiche">
        {imagen.tipo === 'local' ? (
          <Image src={imagen.src} alt="" width={480} height={480} fit="cover" />
        ) : (
          <img src={imagen.src} alt="" width="480" height="480" loading="lazy" decoding="async" />
        )}
      </span>
    )
  }
  <time datetime={data.fecha.toISOString().slice(0, 10)} class="cuando">
    <span class="d dia">{dia}</span>
    <span class="d mes">{mes}</span>
  </time>
  {data.tipo === 'festival' && <span class="festival">Festival</span>}
  <span class="d quien">{titulo.partes.map((p) => (p.azul ? <span class="ciudad">{p.texto}</span> : p.texto))}</span>
  {lineup.length > 0 && <span class="lineup">{data.tipo === 'festival' ? '' : 'Con '}{lineup.join(' · ')}</span>}
  {/* La ciudad ya va en el título, salvo en los festivales. */}
  <span class="donde">{data.venue}{data.tipo === 'festival' && `, ${data.ciudad}`}{data.hora && ` · ${data.hora} h`}</span>
  <span class="entradas">
    <span>{precio ?? 'Ver detalle'}</span>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  </span>
</a>

<style>
  .afiche {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--papel);
    color: var(--tinta);
    padding: 28px 22px 22px;
    transform: rotate(var(--rot));
    box-shadow: 0 10px 24px rgb(0 0 0 / 0.45);
    transition: transform 0.15s ease;
  }
  a.afiche:hover {
    color: var(--tinta);
    transform: rotate(0deg) translateY(-4px);
  }
  .cinta-adhesiva {
    position: absolute;
    top: -12px;
    left: 50%;
    width: 96px;
    height: 26px;
    margin-left: -48px;
    background: rgb(222 212 182 / 0.8);
    transform: rotate(-4deg);
  }
  /* La foto del evento, pegada en el afiche */
  .foto-afiche {
    display: block;
    aspect-ratio: 4 / 3;
    margin: -6px -6px 14px;
    background: #d9d3c6;
  }
  .cuando {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .dia {
    font-size: 56px;
    line-height: 0.9;
  }
  .mes {
    font-size: 22px;
    color: #2f6ea6; /* azul de marca oscurecido para contraste sobre papel */
  }
  .quien {
    font-size: 27px;
    line-height: 1.05;
    margin-top: 10px;
  }
  .ciudad {
    color: #2f6ea6; /* azul de marca oscurecido para contraste sobre papel */
  }
  .festival {
    align-self: flex-start;
    margin-top: 12px;
    padding: 3px 8px;
    background: var(--tinta);
    color: var(--papel);
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transform: rotate(-2deg);
  }
  .festival + .quien {
    margin-top: 8px;
  }
  .lineup {
    margin-top: 6px;
    font-weight: 700;
    font-size: 14px;
    line-height: 1.35;
    color: #2f6ea6;
  }
  .donde {
    font-size: 15px;
    margin-top: 6px;
    color: #3a3a3a;
  }
  .entradas {
    margin-top: 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 2px dashed #b7b0a2;
    padding-top: 12px;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
