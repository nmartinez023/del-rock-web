---
const anio = new Date().getFullYear();
---

<footer class="footer">
  <div class="container interior">
    <div class="pie">
      <span class="d marca">Del Rock <span class="azul">Arg</span></span>
      <nav aria-label="Pie de página" class="links">
        <a href="/noticias/">Noticias</a>
        <a href="/agenda/">Agenda</a>
        <a href="/coberturas/">Coberturas</a>
        <a href="/como-funciona/">Cómo funciona</a>
        <a href="https://www.instagram.com/del.rock.arg/" rel="noopener">Instagram</a>
      </nav>
      <span>© {anio} Del Rock Arg</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background-color: #18181b;
    background-image:
      radial-gradient(ellipse at 20% 0%, rgb(255 255 255 / 0.06), transparent 50%),
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.02) 0 1px, transparent 1px 9px);
  }
  .interior {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-block: 40px 32px;
  }
  .pie {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    color: var(--dim);
  }
  .marca {
    font-size: 22px;
    color: var(--fg);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  .links a {
    color: var(--muted);
    padding-block: 6px;
  }
  .links a:hover {
    color: var(--azul);
  }
</style>
