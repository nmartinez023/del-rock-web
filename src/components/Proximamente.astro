---
// Página de "Próximamente": fondo negro, el logo latiendo al centro y el mensaje. Sin encabezado ni pie.
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

const titulo = 'Del Rock Arg | Próximamente';
const descripcion = 'Rock nacional, todos los días. Noticias, agenda de shows y coberturas. Muy pronto.';
const canonical = new URL('/', Astro.site);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="theme-color" content="#000000" />
    <meta property="og:site_name" content="Del Rock Arg" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/logo.png', Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&display=swap" />
  </head>
  <body>
    <main>
      <h1 class="sr-only">Del Rock Arg</h1>
      <div class="latido">
        <Image src={logo} alt="Del Rock Arg" width={100} height={100} loading="eager" class="logo" />
      </div>
      <p class="mensaje">Próximamente<span class="puntos" aria-hidden="true"><span>.</span><span>.</span><span>.</span></span></p>
    </main>

    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #000;
        color: #f2f2f0;
      }
      main {
        min-height: 100vh;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 24px;
        padding: 24px;
        box-sizing: border-box;
      }
      .latido {
        width: clamp(72px, 22vw, 100px); /* nunca más grande que el PNG (100 px) */
        aspect-ratio: 1;
        animation: latido 1.4s ease-in-out infinite;
        filter: drop-shadow(0 0 0 rgb(64 138 201 / 0));
      }
      .logo {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
      /* Dos golpes y una pausa, como un corazón; el azul de la marca brilla en cada golpe. */
      @keyframes latido {
        0%,
        40%,
        100% {
          transform: scale(1);
          filter: drop-shadow(0 0 0 rgb(64 138 201 / 0));
        }
        12% {
          transform: scale(1.1);
          filter: drop-shadow(0 0 22px rgb(64 138 201 / 0.55));
        }
        24% {
          transform: scale(0.98);
        }
        32% {
          transform: scale(1.06);
          filter: drop-shadow(0 0 16px rgb(64 138 201 / 0.4));
        }
      }
      .mensaje {
        margin: 0;
        font-family: 'Anton', Impact, 'Arial Narrow', sans-serif;
        font-size: clamp(18px, 4vw, 28px);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .puntos span {
        animation: punto 1.4s infinite;
        opacity: 0;
      }
      .puntos span:nth-child(2) {
        animation-delay: 0.2s;
      }
      .puntos span:nth-child(3) {
        animation-delay: 0.4s;
      }
      @keyframes punto {
        0%,
        20% {
          opacity: 0;
        }
        40%,
        100% {
          opacity: 1;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .latido,
        .puntos span {
          animation: none;
          opacity: 1;
        }
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }
    </style>
  </body>
</html>
