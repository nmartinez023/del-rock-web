---
import { INICIO } from '../lib/lanzamiento';
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <section class="container muro">
    <p class="m pintada">Acá no hay nada</p>
    <h1 class="d titulo">Error 404</h1>
    <p class="desc">La página que buscás no existe o se movió.</p>
    <a href={INICIO} class="btn">Volver al inicio</a>
  </section>
</Base>

<style>
  .muro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding-block: 96px 120px;
  }
  .pintada {
    margin: 0;
    font-size: clamp(48px, 9vw, 110px);
    line-height: 1;
    color: var(--azul);
    transform: rotate(-4deg);
  }
  .titulo {
    margin: 24px 0 0;
    font-size: 32px;
  }
  .desc {
    margin: 0;
    color: var(--muted);
  }
</style>
