---
import { Image } from 'astro:assets';
import { bandasVisibles, spotifyDe } from '../../lib/util';
import Base from '../../layouts/Base.astro';
import SeccionTitulo from '../../components/SeccionTitulo.astro';

const bandas = await bandasVisibles();

// Sin foto: las iniciales ("Las Pastillas del Abuelo" → "LP").
const iniciales = (nombre: string) =>
  nombre
    .split(/\s+/)
    .filter((p) => /^[\p{L}\d]/u.test(p))
    .slice(0, 2)
    .map((p) => p[0].toUpperCase())
    .join('');
---

<Base titulo="Bandas" descripcion="Las bandas del rock nacional: noticias, fechas y coberturas de cada una.">
  <section class="container bandas">
    <SeccionTitulo texto="Bandas" nivel="h1" />
    <ul class="grilla">
      {
        bandas.map((b) => (
          <li>
            <a href={`/bandas/${b.id}/`} class="banda">
              <div class="foto">
                {b.data.foto ? (
                  <Image src={b.data.foto} alt="" width={200} height={200} />
                ) : spotifyDe(b)?.foto ? (
                  <img src={spotifyDe(b)!.foto!} alt="" width="200" height="200" loading="lazy" referrerpolicy="no-referrer" />
                ) : (
                  <span class="d iniciales" aria-hidden="true">
                    {iniciales(b.data.nombre)}
                  </span>
                )}
              </div>
              <span class="d nombre">{b.data.nombre}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .bandas {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding-block: 48px 88px;
  }
  .grilla {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(112px, 1fr));
    gap: 24px 12px;
  }
  .banda {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .foto {
    display: grid;
    place-items: center;
    width: 88px;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 2px solid var(--line);
    overflow: hidden;
    background: #16161a;
  }
  .foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .iniciales {
    font-size: 28px;
    color: var(--muted);
  }
  .banda:hover .foto {
    border-color: var(--azul);
  }
  .banda:hover .iniciales {
    color: var(--azul);
  }
  .nombre {
    font-size: 15px;
    line-height: 1.1;
    text-align: center;
    overflow-wrap: anywhere;
  }
  @media (max-width: 600px) {
    .grilla {
      grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
      gap: 20px 8px;
    }
    .foto {
      width: 72px;
    }
    .iniciales {
      font-size: 22px;
    }
    .nombre {
      font-size: 13px;
    }
  }
</style>
