---
import { Image } from 'astro:assets';

import Base from '../../layouts/Base.astro';
import SeccionTitulo from '../../components/SeccionTitulo.astro';
import NoticiaCard from '../../components/NoticiaCard.astro';
import AgendaGrid from '../../components/AgendaGrid.astro';
import { bandasVisibles, noticiasOrdenadas, proximasFechas, tocaEn } from '../../lib/util';

export async function getStaticPaths() {
  const bandas = await bandasVisibles();
  return bandas.map((banda) => ({ params: { slug: banda.id }, props: { banda } }));
}

const { banda } = Astro.props;
const { data } = banda;
const noticias = (await noticiasOrdenadas()).filter((n) => n.data.banda?.id === banda.id);
const fechas = (await proximasFechas()).filter((f) => tocaEn(f, banda.id));
---

<Base titulo={data.nombre} descripcion={data.descripcion ?? `Noticias, fechas y coberturas de ${data.nombre} en Del Rock.`}>
  <header class="container cabecera">
    {data.foto && <div class="foto avatar"><Image src={data.foto} alt="" width={240} height={240} loading="eager" /></div>}
    <div class="texto">
      <h1 class="d nombre">{data.nombre}</h1>
      {data.descripcion && <p class="desc">{data.descripcion}</p>}
      <div class="links">
        {data.instagram && <a class="btn btn--borde" href={data.instagram} rel="noopener">Instagram</a>}
        {data.spotify && <a class="btn btn--borde" href={data.spotify} rel="noopener">Spotify</a>}
      </div>
    </div>
  </header>

  {
    fechas.length > 0 && (
      <section class="container bloque">
        <SeccionTitulo texto="Próximas fechas" />
        <AgendaGrid fechas={fechas} filtro={false} variante="lista" />
      </section>
    )
  }

  <section class="container bloque">
    <SeccionTitulo texto="Notas" />
    {
      noticias.length > 0 ? (
        <div class="grilla">
          {noticias.map((n) => (
            <NoticiaCard noticia={n} />
          ))}
        </div>
      ) : (
        <p class="desc">Todavía no hay notas de {data.nombre}.</p>
      )
    }
  </section>
</Base>

<style>
  .cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px;
    padding-block: 48px 24px;
  }
  .avatar {
    width: clamp(120px, 20vw, 200px);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 3px solid var(--azul);
  }
  .texto {
    flex: 1 1 320px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .nombre {
    margin: 0;
    font-size: clamp(48px, 8vw, 96px);
    line-height: 0.95;
  }
  .desc {
    margin: 0;
    color: var(--muted);
    font-size: 18px;
    max-width: 60ch;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .bloque {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-block: 48px;
  }
  .grilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 44px 32px;
  }
</style>
