---
import { Image, getImage } from 'astro:assets';
import { getCollection, getEntries } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SeccionTitulo from '../../../components/SeccionTitulo.astro';
import AgendaGrid from '../../../components/AgendaGrid.astro';
import Sticker from '../../../components/Sticker.astro';
import { bandasVisibles, diaMes, fechaCompleta, imagenDeFecha, precioTexto, proximasFechas, slugTag, type Fecha } from '../../../lib/util';

export async function getStaticPaths() {
  const fechas = await getCollection('agenda', (f) => f.data.estado === 'publicado');
  return fechas.map((fecha) => ({ params: { slug: fecha.id }, props: { fecha } }));
}

interface Props {
  fecha: Fecha;
}

const { fecha } = Astro.props;
const { data } = fecha;
const dia = data.fecha.toISOString().slice(0, 10);
const { dia: numDia, mes } = diaMes(data.fecha);

const visibles = new Set((await bandasVisibles()).map((b) => b.id));
const bandas = (await getEntries(data.bandas)).filter(Boolean);
// Si la única banda es el título ("2 MINUTOS"), el sticker sobra.
const mostrarBandas = bandas.length > 1 || (bandas.length === 1 && slugTag(bandas[0].data.nombre) !== slugTag(data.titulo));
const precio = precioTexto(data.precioDesde);
const imagen = imagenDeFecha(fecha);
const hoy = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Argentina/Buenos_Aires' });
const yaPaso = dia < hoy;

const lugar = [data.venue, data.direccion, data.ciudad, data.provincia].filter(Boolean);
const mapa = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent([...lugar, 'Argentina'].join(', '))}`;
const vendedor = data.entradas ? new URL(data.entradas).hostname.replace(/^www\./, '') : null;

// Otras fechas: primero las de las mismas bandas, después las más próximas.
const proximas = (await proximasFechas()).filter((f) => f.id !== fecha.id);
const ids = new Set(data.bandas.map((b) => b.id));
const relacionadas = [
  ...proximas.filter((f) => f.data.bandas.some((b) => ids.has(b.id))),
  ...proximas.filter((f) => !f.data.bandas.some((b) => ids.has(b.id))),
].slice(0, 4);

// Imagen para compartir y para Google.
const url = new URL(Astro.url.pathname, Astro.site).toString();
const og = imagen?.tipo === 'local' ? (await getImage({ src: imagen.src, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src : imagen?.src;
const descripcionCorta = `${data.titulo} · ${fechaCompleta(data.fecha)}${data.hora ? `, ${data.hora} h` : ''} · ${data.venue}, ${data.ciudad}.${precio ? ` ${precio}.` : ''}`;
const inicio = data.hora ? `${dia}T${data.hora}:00-03:00` : dia;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': data.tipo === 'festival' ? 'Festival' : 'MusicEvent',
  name: data.titulo,
  startDate: inicio,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: data.venue,
    address: { '@type': 'PostalAddress', streetAddress: data.direccion, addressLocality: data.ciudad, addressRegion: data.provincia, addressCountry: 'AR' },
  },
  ...(og ? { image: new URL(og, Astro.site).toString() } : {}),
  ...(data.descripcion ? { description: data.descripcion } : {}),
  ...(bandas.length ? { performer: bandas.map((b) => ({ '@type': 'MusicGroup', name: b.data.nombre })) } : {}),
  ...(data.entradas
    ? { offers: { '@type': 'Offer', url: data.entradas, ...(data.precioDesde != null ? { price: data.precioDesde, priceCurrency: 'ARS' } : {}) } }
    : {}),
};
const compartirTexto = encodeURIComponent(`${data.titulo} · ${fechaCompleta(data.fecha)} ${url}`);
---

<Base titulo={data.titulo} descripcion={descripcionCorta} imagen={og ?? undefined} tipo="article">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="container evento">
    <nav aria-label="Ruta" class="ruta"><a href="/agenda/">Agenda</a> / <span>{data.titulo}</span></nav>

    <div class="cabecera">
      <div class="visual">
        {
          imagen ? (
            <div class="foto marco">
              {imagen.tipo === 'local' ? (
                <Image src={imagen.src} alt={`Flyer de ${data.titulo}`} width={800} widths={[400, 800]} sizes="(max-width: 900px) 100vw, 520px" loading="eager" />
              ) : (
                <img src={imagen.src} alt={`Flyer de ${data.titulo}`} width="800" height="800" loading="eager" decoding="async" />
              )}
            </div>
          ) : (
            <div class="sin-foto" aria-hidden="true">
              <span class="d dia-grande">{numDia}</span>
              <span class="d mes-grande">{mes}</span>
            </div>
          )
        }
      </div>

      <div class="datos">
        {data.tipo === 'festival' && <span class="chip chip--azul">Festival</span>}
        <h1 class="d titulo">{data.titulo}</h1>

        {
          mostrarBandas && (
            <div class="bandas" aria-label="Bandas">
              {bandas.map((b, i) =>
                visibles.has(b.id) ? (
                  <Sticker href={`/bandas/${b.id}/`} texto={b.data.nombre} i={i} />
                ) : (
                  <span class="sticker sticker--suelto">{b.data.nombre}</span>
                ),
              )}
            </div>
          )
        }

        {yaPaso && <p class="paso">Este evento ya pasó.</p>}

        <dl class="ficha">
          <div>
            <dt>Cuándo</dt>
            <dd>
              <time datetime={inicio}>
                <span class="primera">{fechaCompleta(data.fecha)}</span>
                {data.hora && <span>{data.hora} h</span>}
              </time>
            </dd>
          </div>
          <div>
            <dt>Dónde</dt>
            <dd>
              <span class="primera">{data.venue}</span>
              <span>{[data.direccion, data.ciudad, data.provincia].filter(Boolean).join(', ')}</span>
              <a href={mapa} rel="noopener" class="mapa">Cómo llegar</a>
            </dd>
          </div>
          {
            precio && (
              <div>
                <dt>Entradas</dt>
                <dd>
                  <span class="primera">{precio}</span>
                  {data.precioDesde ? <span>Precio de referencia. Puede haber cargos por servicio.</span> : null}
                </dd>
              </div>
            )
          }
          {
            data.aviso && (
              <div>
                <dt>Importante</dt>
                <dd><span class="primera">{data.aviso}</span></dd>
              </div>
            )
          }
        </dl>

        <div class="acciones">
          {
            data.entradas && !yaPaso && (
              <a href={data.entradas} rel="noopener" class="btn comprar">
                Comprar entradas
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
              </a>
            )
          }
          <div class="compartir" role="group" aria-label="Compartir">
            <a class="redondo" href={`https://wa.me/?text=${compartirTexto}`} rel="noopener" aria-label="Compartir por WhatsApp">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20l1.3-4A8 8 0 1 1 8 18.7z"></path></svg>
            </a>
            <a class="redondo" href={`https://x.com/intent/post?text=${compartirTexto}`} rel="noopener" aria-label="Compartir en X">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20"></path></svg>
            </a>
            <button class="redondo" type="button" data-copiar={url} aria-label="Copiar link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"></path><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"></path></svg>
            </button>
            <span class="copiado" role="status" aria-live="polite"></span>
          </div>
        </div>
        {vendedor && !yaPaso && <p class="vendedor">La compra se hace en {vendedor}.</p>}
      </div>
    </div>

    {
      data.descripcion && (
        <section class="descripcion" aria-labelledby="sobre">
          <h2 id="sobre" class="m sobre">Sobre el evento</h2>
          {data.descripcion.split(/\n{2,}/).map((p) => (
            <p>{p}</p>
          ))}
        </section>
      )
    }
  </article>

  {
    relacionadas.length > 0 && (
      <section class="mas">
        <div class="container mas-interior">
          <SeccionTitulo texto="Más fechas" />
          <AgendaGrid fechas={relacionadas} filtro={false} />
          <a href="/agenda/" class="ver-mas">Ver toda la agenda</a>
        </div>
      </section>
    )
  }
</Base>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copiar]')) {
    b.addEventListener('click', async () => {
      const aviso = b.parentElement?.querySelector('.copiado');
      try {
        await navigator.clipboard.writeText(b.dataset.copiar!);
        if (aviso) aviso.textContent = 'Link copiado';
      } catch {
        if (aviso) aviso.textContent = 'No se pudo copiar';
      }
      setTimeout(() => aviso && (aviso.textContent = ''), 2500);
    });
  }
</script>

<style>
  .evento {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-block: 40px 72px;
  }
  .ruta {
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--dim);
  }
  .cabecera {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: flex-start;
  }
  .visual {
    flex: 1 1 340px;
    max-width: 520px;
    min-width: 0;
  }
  .marco {
    aspect-ratio: 1;
    border-radius: 4px;
    box-shadow: 0 14px 40px rgb(0 0 0 / 0.5);
    transform: rotate(-1.2deg);
  }
  .sin-foto {
    aspect-ratio: 1;
    background: var(--papel);
    color: var(--tinta);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transform: rotate(-1.2deg);
    box-shadow: 0 14px 40px rgb(0 0 0 / 0.5);
  }
  .dia-grande {
    font-size: clamp(120px, 22vw, 200px);
    line-height: 0.85;
  }
  .mes-grande {
    font-size: clamp(36px, 6vw, 56px);
    color: #2f6ea6;
  }
  .datos {
    flex: 999 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .datos .chip {
    align-self: flex-start;
  }
  .titulo {
    margin: 0;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 0.98;
    overflow-wrap: anywhere;
  }
  .bandas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
  }
  .sticker--suelto {
    font-size: 18px;
    background: var(--bg);
    color: var(--fg);
    border-color: var(--line);
  }
  .paso {
    margin: 0;
    padding: 10px 14px;
    border: 1px solid var(--line);
    color: var(--muted);
  }
  .ficha {
    margin: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }
  .ficha > div {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 16px;
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
  }
  dt {
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--azul);
    padding-top: 3px;
  }
  dd {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--muted);
  }
  dd time {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .primera {
    color: var(--fg);
    font-weight: 700;
    font-size: 18px;
  }
  .primera::first-letter {
    text-transform: uppercase;
  }
  .mapa {
    color: var(--azul);
    font-weight: 700;
    font-size: 15px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .comprar {
    min-height: 52px;
    padding-inline: 26px;
    font-size: 17px;
  }
  .compartir {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .redondo {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid #3a3a40;
    background: transparent;
    color: var(--fg);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .redondo:hover {
    border-color: var(--azul);
    color: var(--azul);
  }
  .copiado {
    font-size: 13px;
    color: var(--azul);
  }
  .vendedor {
    margin: -8px 0 0;
    font-size: 13px;
    color: var(--dim);
  }
  .descripcion {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 12px;
  }
  .descripcion p {
    margin: 0;
    font-size: 18px;
    line-height: 1.7;
    color: #d6d6da;
    white-space: pre-line;
  }
  .sobre {
    margin: 0;
    font-size: 28px;
    color: var(--azul);
    transform: rotate(-2deg);
    transform-origin: left;
  }
  .mas {
    border-top: 1px solid var(--line);
  }
  .mas-interior {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-block: 64px 80px;
  }
  .ver-mas {
    align-self: flex-start;
    font-weight: 700;
    border-bottom: 2px solid var(--azul);
    padding-bottom: 4px;
  }
  @media (max-width: 560px) {
    .ficha > div {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .comprar {
      flex: 1 1 100%;
    }
  }
</style>
