---
import { getImage } from 'astro:assets';
import FotoCompleta from '../../../components/FotoCompleta.astro';
import AvisoAgenda from '../../../components/AvisoAgenda.astro';
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SeccionTitulo from '../../../components/SeccionTitulo.astro';
import AgendaGrid from '../../../components/AgendaGrid.astro';
import Sticker from '../../../components/Sticker.astro';
import {
  bandasDe, bandasVisibles, diaMes, diaYMes, fechaCompleta, imagenDeFecha, precioTexto, proximasFechas,
  slugsDeAgenda, slugTag, tituloConCiudad, type Fecha,
} from '../../../lib/util';
import type { DatosHistoria } from '../../../lib/historia';

export async function getStaticPaths() {
  const fechas = await getCollection('agenda', (f) => f.data.estado === 'publicado' && f.data.rockNacional);
  const slugs = await slugsDeAgenda();
  return fechas.flatMap((fecha) => {
    const slug = slugs.get(fecha.id)!;
    const paginas = [{ params: { slug }, props: { fecha } }];
    // La URL vieja (nombre del archivo, "2026-11-21-cruzando-el-charco") redirige a la nueva.
    if (fecha.id !== slug) paginas.push({ params: { slug: fecha.id }, props: { fecha, redirigir: `/agenda/${slug}/` } });
    return paginas;
  });
}

interface Props {
  fecha: Fecha;
  redirigir?: string;
}

const { fecha, redirigir } = Astro.props;
if (redirigir) return Astro.redirect(redirigir, 301);
const { data } = fecha;
const dia = data.fecha.toISOString().slice(0, 10);
const { dia: numDia, mes } = diaMes(data.fecha);

const visibles = new Set((await bandasVisibles()).map((b) => b.id));
const bandas = await bandasDe(fecha);
// Si la única banda es el título ("2 MINUTOS"), el sticker sobra.
// Más de 3 bandas es un festival: no se listan (mismo criterio que el recolector).
const mostrarBandas =
  bandas.length <= 3 && (bandas.length > 1 || (bandas.length === 1 && slugTag(bandas[0].data.nombre) !== slugTag(data.titulo)));
const precio = precioTexto(data.precioDesde);
const ruta = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const imagen = imagenDeFecha(fecha, ruta);
const titulo = tituloConCiudad(fecha);
const hoy = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Argentina/Buenos_Aires' });
const yaPaso = dia < hoy;

const lugar = [data.venue, data.direccion, data.ciudad, data.provincia].filter(Boolean);
const mapa = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent([...lugar, 'Argentina'].join(', '))}`;
const vendedor = data.entradas ? new URL(data.entradas).hostname.replace(/^www\./, '') : null;

// Otras fechas: primero las de las mismas bandas, después las más próximas.
const proximas = (await proximasFechas()).filter((f) => f.id !== fecha.id);
const ids = new Set(data.bandas);
const relacionadas = [
  ...proximas.filter((f) => f.data.bandas.some((b) => ids.has(b))),
  ...proximas.filter((f) => !f.data.bandas.some((b) => ids.has(b))),
].slice(0, 4);

// Imagen para compartir y para Google.
const url = new URL(Astro.url.pathname, Astro.site).toString();
const og = imagen?.tipo === 'local' ? (await getImage({ src: imagen.src, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src : imagen?.src;
// Título y descripción para buscadores: qué, dónde y cuándo.
const tituloPagina = `${titulo.texto} · ${diaYMes(data.fecha)}`;
const descripcionCorta =
  `${titulo.texto}: ${fechaCompleta(data.fecha)}${data.hora ? `, ${data.hora} h` : ''}, en ${data.venue} (${data.ciudad}, ${data.provincia}).` +
  `${precio ? ` Entradas ${precio.toLowerCase()}.` : ''}`;
const inicio = data.hora ? `${dia}T${data.hora}:00-03:00` : dia;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': data.tipo === 'festival' ? 'Festival' : 'MusicEvent',
  name: data.titulo,
  startDate: inicio,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: data.venue,
    address: { '@type': 'PostalAddress', streetAddress: data.direccion, addressLocality: data.ciudad, addressRegion: data.provincia, addressCountry: 'AR' },
  },
  ...(og ? { image: new URL(og, Astro.site).toString() } : {}),
  ...(data.descripcion ? { description: data.descripcion } : {}),
  ...(bandas.length ? { performer: bandas.map((b) => ({ '@type': 'MusicGroup', name: b.data.nombre })) } : {}),
  ...(data.entradas
    ? { offers: { '@type': 'Offer', url: data.entradas, ...(data.precioDesde != null ? { price: data.precioDesde, priceCurrency: 'ARS' } : {}) } }
    : {}),
};
const compartirTexto = encodeURIComponent(`${titulo.texto} · ${fechaCompleta(data.fecha)} ${url}`);

// Datos para la imagen de historias de Instagram (se dibuja en el navegador, ver lib/historia.ts).
const diaSemana = data.fecha.toLocaleDateString('es-AR', { weekday: 'long', timeZone: 'UTC' });
const historia: DatosHistoria = {
  partes: titulo.partes,
  cuando: `${diaSemana.charAt(0).toUpperCase()}${diaSemana.slice(1)} ${diaYMes(data.fecha)}`,
  hora: data.hora ? `${data.hora} h` : null,
  venue: data.venue,
  direccion: [data.direccion, data.ciudad].filter(Boolean).join(', '),
  flyer: imagen?.tipo === 'local' ? (await getImage({ src: imagen.src, width: 1080, format: 'jpg' })).src : (imagen?.src ?? null),
  dia: String(numDia),
  mes,
};
const linkHistoria = data.entradas ?? url;
---

<Base titulo={tituloPagina} descripcion={descripcionCorta} imagen={og ?? undefined} tipo="article">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="container evento">
    <nav aria-label="Ruta" class="ruta"><a href="/agenda/">Agenda</a> / <span>{titulo.texto}</span></nav>

    <div class="cabecera">
      <div class="visual">
        {
          imagen ? (
            <div class="foto marco">
              <FotoCompleta
                imagen={imagen}
                alt={`Flyer de ${titulo.texto}, ${diaYMes(data.fecha)}`}
                ancho={800}
                anchos={[400, 800]}
                sizes="(max-width: 900px) 100vw, 520px"
                eager
              />
            </div>
          ) : (
            <div class="sin-foto" aria-hidden="true">
              <span class="d dia-grande">{numDia}</span>
              <span class="d mes-grande">{mes}</span>
            </div>
          )
        }
      </div>

      <div class="datos">
        {data.tipo === 'festival' && <span class="chip chip--azul">Festival</span>}
        <h1 class="d titulo">{titulo.partes.map((p) => (p.azul ? <span class="azul">{p.texto}</span> : p.texto))}</h1>

        {
          mostrarBandas && (
            <div class="bandas" aria-label="Bandas">
              {bandas.map((b, i) =>
                visibles.has(b.id) ? (
                  <Sticker href={`/bandas/${b.id}/`} texto={b.data.nombre} i={i} />
                ) : (
                  <span class="sticker sticker--suelto">{b.data.nombre}</span>
                ),
              )}
            </div>
          )
        }

        {yaPaso && <p class="paso">Este evento ya pasó.</p>}

        <dl class="ficha">
          <div>
            <dt>Cuándo</dt>
            <dd>
              <time datetime={inicio}>
                <span class="primera">{fechaCompleta(data.fecha)}</span>
                {data.hora && <span>{data.hora} h</span>}
              </time>
            </dd>
          </div>
          <div>
            <dt>Dónde</dt>
            <dd>
              <span class="primera">{data.venue}</span>
              <span>{[data.direccion, data.ciudad, data.provincia].filter(Boolean).join(', ')}</span>
              <a href={mapa} target="_blank" rel="noopener" class="mapa">Cómo llegar<span class="sr-only"> (abre Google Maps en otra pestaña)</span></a>
            </dd>
          </div>
          {
            precio && (
              <div>
                <dt>Entradas</dt>
                <dd>
                  <span class="primera">{precio}</span>
                  {data.precioDesde ? <span>Precio de referencia. Puede haber cargos por servicio.</span> : null}
                </dd>
              </div>
            )
          }
          {
            data.aviso && (
              <div>
                <dt>Importante</dt>
                <dd><span class="primera">{data.aviso}</span></dd>
              </div>
            )
          }
        </dl>

        <div class="acciones">
          {
            data.entradas && !yaPaso && (
              <a href={data.entradas} rel="noopener" class="btn comprar">
                Comprar entradas
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
              </a>
            )
          }
          <div class="compartir" role="group" aria-label="Compartir">
            <a class="redondo" href={`https://wa.me/?text=${compartirTexto}`} rel="noopener" aria-label="Compartir por WhatsApp">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20l1.3-4A8 8 0 1 1 8 18.7z"></path></svg>
            </a>
            <a class="redondo" href={`https://x.com/intent/post?text=${compartirTexto}`} rel="noopener" aria-label="Compartir en X">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20"></path></svg>
            </a>
            <button class="redondo" type="button" data-copiar={url} aria-label="Copiar link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"></path><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"></path></svg>
            </button>
            {
              !yaPaso && (
                <button class="redondo" type="button" data-historia={JSON.stringify(historia)} aria-label="Compartir en historias de Instagram">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle></svg>
                </button>
              )
            }
            <span class="copiado" role="status" aria-live="polite"></span>
          </div>
        </div>
        {
          !yaPaso && (
            <dialog class="historia" aria-labelledby="historia-titulo">
              <div class="historia-cabeza">
                <h2 id="historia-titulo" class="d">Compartir en historias</h2>
                <button class="redondo" type="button" data-cerrar aria-label="Cerrar">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
                </button>
              </div>
              <div class="historia-vista">
                <p class="historia-estado" role="status">Armando la imagen…</p>
                <img alt="Vista previa de la historia" hidden />
              </div>
              <p class="historia-ayuda">
                Al publicarla, sumá el <strong>sticker de enlace</strong> en el espacio libre de abajo y pegá el link{' '}
                {data.entradas ? 'de las entradas' : 'del evento'}.
              </p>
              <div class="historia-acciones">
                <button class="btn" type="button" data-compartir hidden>Compartir imagen</button>
                <a class="btn" data-descargar download={`delrock-${Astro.params.slug}.png`} hidden>Descargar imagen</a>
                <button class="btn btn--borde" type="button" data-copiar-link={linkHistoria}>
                  Copiar link {data.entradas ? 'de entradas' : 'del evento'}
                </button>
              </div>
              <span class="historia-aviso" role="status" aria-live="polite"></span>
            </dialog>
          )
        }
        {vendedor && !yaPaso && <p class="vendedor">La compra se hace en {vendedor}.</p>}
        {!yaPaso && <AvisoAgenda variante="corto" />}
      </div>
    </div>

    {
      data.descripcion && (
        <section class="descripcion" aria-labelledby="sobre">
          <h2 id="sobre" class="m sobre">Sobre el evento</h2>
          {data.descripcion.split(/\n{2,}/).map((p) => (
            <p>{p}</p>
          ))}
        </section>
      )
    }
  </article>

  {
    relacionadas.length > 0 && (
      <section class="mas">
        <div class="container mas-interior">
          <SeccionTitulo texto="Más fechas" />
          <AgendaGrid fechas={relacionadas} filtro={false} />
          <a href="/agenda/" class="ver-mas">Ver toda la agenda</a>
        </div>
      </section>
    )
  }
</Base>

<script>
  // Flyer tipo banner (mucho más ancho que alto): en el celular se muestra con su proporción
  // en vez del cuadrado (ver .marco.es-banner). La medida se toma al cargar la foto.
  const marco = document.querySelector<HTMLElement>('.marco');
  const flyer = marco?.querySelector<HTMLImageElement>('img.frente');
  const medir = () => {
    if (!marco || !flyer?.naturalWidth || !flyer.naturalHeight) return;
    const proporcion = flyer.naturalWidth / flyer.naturalHeight;
    if (proporcion >= 1.4) {
      marco.style.setProperty('--proporcion', String(proporcion));
      marco.classList.add('es-banner');
    }
  };
  medir(); // si ya había cargado
  flyer?.addEventListener('load', medir);

  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copiar]')) {
    b.addEventListener('click', async () => {
      const aviso = b.parentElement?.querySelector('.copiado');
      try {
        await navigator.clipboard.writeText(b.dataset.copiar!);
        if (aviso) aviso.textContent = 'Link copiado';
      } catch {
        if (aviso) aviso.textContent = 'No se pudo copiar';
      }
      setTimeout(() => aviso && (aviso.textContent = ''), 2500);
    });
  }

  // Historia de Instagram: la imagen se arma al abrir el diálogo; compartir va en otro toque
  // porque el navegador sólo deja compartir justo después de que la persona toca algo.
  const botonHistoria = document.querySelector<HTMLButtonElement>('[data-historia]');
  const dialogo = document.querySelector<HTMLDialogElement>('dialog.historia');
  if (botonHistoria && dialogo) {
    const vista = dialogo.querySelector('img')!;
    const estado = dialogo.querySelector<HTMLElement>('.historia-estado')!;
    const compartir = dialogo.querySelector<HTMLButtonElement>('[data-compartir]')!;
    const descargar = dialogo.querySelector<HTMLAnchorElement>('[data-descargar]')!;
    const aviso = dialogo.querySelector<HTMLElement>('.historia-aviso')!;
    let archivo: File | null = null;

    const avisar = (texto: string) => {
      aviso.textContent = texto;
      setTimeout(() => (aviso.textContent = ''), 3000);
    };

    botonHistoria.addEventListener('click', async () => {
      dialogo.showModal();
      if (archivo) return;
      try {
        const { generarHistoria } = await import('../../../lib/historia');
        const blob = await generarHistoria(JSON.parse(botonHistoria.dataset.historia!));
        archivo = new File([blob], descargar.download, { type: 'image/png' });
        const enlace = URL.createObjectURL(blob);
        vista.src = enlace;
        vista.hidden = false;
        estado.hidden = true;
        descargar.href = enlace;
        if (navigator.canShare?.({ files: [archivo] })) compartir.hidden = false;
        else descargar.hidden = false;
      } catch {
        estado.textContent = 'No se pudo armar la imagen. Probá de nuevo más tarde.';
      }
    });

    compartir.addEventListener('click', async () => {
      if (!archivo) return;
      try {
        await navigator.share({ files: [archivo] });
      } catch (e) {
        // Si la persona cierra el menú no es un error; si falla, queda la descarga.
        if ((e as Error).name !== 'AbortError') {
          descargar.hidden = false;
          avisar('No se pudo compartir: descargá la imagen y subila a tu historia.');
        }
      }
    });

    dialogo.querySelector<HTMLButtonElement>('[data-copiar-link]')!.addEventListener('click', async (ev) => {
      try {
        await navigator.clipboard.writeText((ev.currentTarget as HTMLButtonElement).dataset.copiarLink!);
        avisar('Link copiado');
      } catch {
        avisar('No se pudo copiar');
      }
    });

    dialogo.querySelector('[data-cerrar]')!.addEventListener('click', () => dialogo.close());
    // Tocar afuera del recuadro también cierra.
    dialogo.addEventListener('click', (ev) => ev.target === dialogo && dialogo.close());
  }
</script>

<style>
  .evento {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-block: 40px 72px;
  }
  .ruta {
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--dim);
  }
  .cabecera {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: flex-start;
  }
  .visual {
    flex: 1 1 340px;
    max-width: 520px;
    min-width: 0;
  }
  .marco {
    aspect-ratio: 1;
    border-radius: 4px;
    box-shadow: 0 14px 40px rgb(0 0 0 / 0.5);
    transform: rotate(-1.2deg);
  }
  .sin-foto {
    aspect-ratio: 1;
    background: var(--papel);
    color: var(--tinta);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transform: rotate(-1.2deg);
    box-shadow: 0 14px 40px rgb(0 0 0 / 0.5);
  }
  .dia-grande {
    font-size: clamp(120px, 22vw, 200px);
    line-height: 0.85;
  }
  .mes-grande {
    font-size: clamp(36px, 6vw, 56px);
    color: #2f6ea6;
  }
  .datos {
    flex: 999 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .datos .chip {
    align-self: flex-start;
  }
  .titulo {
    margin: 0;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 0.98;
    overflow-wrap: anywhere;
  }
  .bandas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
  }
  .sticker--suelto {
    font-size: 18px;
    background: var(--bg);
    color: var(--fg);
    border-color: var(--line);
  }
  .paso {
    margin: 0;
    padding: 10px 14px;
    border: 1px solid var(--line);
    color: var(--muted);
  }
  .ficha {
    margin: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }
  .ficha > div {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 16px;
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
  }
  dt {
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--azul);
    padding-top: 3px;
  }
  dd {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--muted);
  }
  dd time {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .primera {
    color: var(--fg);
    font-weight: 700;
    font-size: 18px;
  }
  .primera::first-letter {
    text-transform: uppercase;
  }
  .mapa {
    color: var(--azul);
    font-weight: 700;
    font-size: 15px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .comprar {
    min-height: 52px;
    padding-inline: 26px;
    font-size: 17px;
  }
  .compartir {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .redondo {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid #3a3a40;
    background: transparent;
    color: var(--fg);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .redondo:hover {
    border-color: var(--azul);
    color: var(--azul);
  }
  .copiado {
    font-size: 13px;
    color: var(--azul);
  }
  .historia {
    width: min(440px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--fg);
  }
  .historia[open] {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .historia::backdrop {
    background: rgb(0 0 0 / 0.75);
  }
  .historia-cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .historia-cabeza h2 {
    margin: 0;
    font-size: 26px;
  }
  .historia-vista {
    flex: 0 1 auto;
    min-height: 0;
    display: flex;
    justify-content: center;
  }
  .historia-vista img {
    display: block;
    height: min(56dvh, 560px);
    aspect-ratio: 9 / 16;
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .historia-estado {
    margin: 0;
    height: min(56dvh, 560px);
    aspect-ratio: 9 / 16;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 16px;
    border: 1px dashed var(--line);
    border-radius: 6px;
    color: var(--muted);
    font-size: 14px;
  }
  .historia-vista [hidden] {
    display: none;
  }
  .historia-ayuda {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  .historia-ayuda strong {
    color: var(--fg);
  }
  .historia-acciones {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .historia-acciones [hidden] {
    display: none;
