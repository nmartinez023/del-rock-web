---
import { Image, getImage } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Titular from '../../components/Titular.astro';
import NoticiaCard from '../../components/NoticiaCard.astro';
import SeccionTitulo from '../../components/SeccionTitulo.astro';
import Afiche from '../../components/Afiche.astro';
import Sticker from '../../components/Sticker.astro';
import InstagramEmbed from '../../components/InstagramEmbed.astro';
import { TIPOS, fechaLarga, minutosDeLectura, noticiasOrdenadas, proximasFechas, slugTag, tocaEn } from '../../lib/util';

export async function getStaticPaths() {
  const noticias = await noticiasOrdenadas();
  return noticias.map((noticia) => ({ params: { slug: noticia.id }, props: { noticia } }));
}

const { noticia } = Astro.props;
const { data } = noticia;
const { Content } = await render(noticia);
const banda = data.banda ? await getEntry(data.banda) : undefined;

const todas = await noticiasOrdenadas();
const otras = todas.filter((n) => n.id !== noticia.id);
const deLaBanda = banda ? otras.filter((n) => n.data.banda?.id === banda.id).slice(0, 3) : [];
const seguiLeyendo = otras.filter((n) => !deLaBanda.includes(n)).slice(0, 3);
const proxima = banda ? (await proximasFechas()).find((f) => tocaEn(f, banda.id)) : undefined;

const og = await getImage({ src: data.portada, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const url = new URL(Astro.url.pathname, Astro.site).toString();
const compartirTexto = encodeURIComponent(`${data.titulo} ${url}`);
---

<Base titulo={data.titulo} descripcion={data.bajada} imagen={og.src} tipo="article">
  <article>
    <header class="container cabecera">
      <nav aria-label="Ruta" class="ruta"><a href="/noticias/">Noticias</a> / <span>{TIPOS[data.tipo]}</span></nav>
      {
        banda ? (
          <a href={`/bandas/${banda.id}/`} class="kicker kicker--linea">
            {banda.data.nombre}
          </a>
        ) : (
          <span class="kicker kicker--linea">{TIPOS[data.tipo]}</span>
        )
      }
      <h1 class="d titulo"><Titular titulo={data.titulo} destacado={data.destacado} /></h1>
      {data.bajada && <p class="bajada">{data.bajada}</p>}
      <div class="barra">
        <p class="meta">
          Por <strong>Del Rock</strong> · <time datetime={data.fecha.toISOString().slice(0, 10)}>{fechaLarga(data.fecha)}</time> ·
          {minutosDeLectura(noticia.body ?? '')} min de lectura
        </p>
        <div class="compartir" role="group" aria-label="Compartir">
          <a class="redondo" href={`https://wa.me/?text=${compartirTexto}`} rel="noopener" aria-label="Compartir por WhatsApp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20l1.3-4A8 8 0 1 1 8 18.7z"></path></svg>
          </a>
          <a class="redondo" href={`https://x.com/intent/post?text=${compartirTexto}`} rel="noopener" aria-label="Compartir en X">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20"></path></svg>
          </a>
          <button class="redondo" type="button" data-copiar={url} aria-label="Copiar link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"></path><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"></path></svg>
          </button>
          <span class="copiado" role="status" aria-live="polite"></span>
        </div>
      </div>
    </header>

    <div class="container">
      <div class="portada foto">
        <Image src={data.portada} alt={data.portadaAlt ?? ''} width={1280} widths={[640, 960, 1280]} sizes="(max-width: 1280px) 100vw, 1216px" loading="eager" fetchpriority="high" />
      </div>
    </div>

    <div class="container cuerpo-wrap">
      <div class="cuerpo">
        <div class="prosa">
          <Content />
        </div>

        {
          data.galeria.length > 0 && (
            <section class="galeria" aria-label="Galería de fotos">
              {data.galeria.map((g) => (
                <figure>
                  <div class="foto">
                    <Image src={g.imagen} alt={g.epigrafe ?? ''} width={720} widths={[360, 720]} sizes="(max-width: 760px) 100vw, 720px" />
                  </div>
                  {g.epigrafe && <figcaption>{g.epigrafe}</figcaption>}
                </figure>
              ))}
            </section>
          )
        }

        {data.instagram && <InstagramEmbed url={data.instagram} />}

        {
          data.tags.length > 0 && (
            <div class="tags">
              {data.tags.map((t, i) => (
                <Sticker href={`/tags/${slugTag(t)}/`} texto={t} i={i} />
              ))}
            </div>
          )
        }
      </div>

      {(proxima || deLaBanda.length > 0) && <aside class="lateral">
        {
          proxima && (
            <div class="lateral-bloque">
              <h2 class="m lateral-titulo">Próxima fecha</h2>
              <Afiche fecha={proxima} i={1} />
            </div>
          )
        }
        {
          deLaBanda.length > 0 && (
            <div class="lateral-bloque">
              <h2 class="m lateral-titulo">Más de {banda?.data.nombre}</h2>
              <div>
                {deLaBanda.map((n) => (
                  <NoticiaCard noticia={n} variante="lista" />
                ))}
              </div>
            </div>
          )
        }
      </aside>}
    </div>
  </article>

  {
    seguiLeyendo.length > 0 && (
      <section class="seguir">
        <div class="container seguir-interior">
          <SeccionTitulo texto="Seguí leyendo" />
          <div class="grilla">
            {seguiLeyendo.map((n) => (
              <NoticiaCard noticia={n} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copiar]')) {
    b.addEventListener('click', async () => {
      const aviso = b.parentElement?.querySelector('.copiado');
      try {
        await navigator.clipboard.writeText(b.dataset.copiar!);
        if (aviso) aviso.textContent = 'Link copiado';
      } catch {
        if (aviso) aviso.textContent = 'No se pudo copiar';
      }
      setTimeout(() => aviso && (aviso.textContent = ''), 2500);
    });
  }
</script>

<style>
  .cabecera {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-block: 48px 32px;
  }
  .ruta {
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--dim);
  }
  .titulo {
    margin: 0;
    font-size: clamp(44px, 7vw, 84px);
    line-height: 0.96;
    max-width: 18ch;
  }
  .bajada {
    margin: 0;
    font-size: clamp(19px, 2.2vw, 22px);
    line-height: 1.5;
    color: var(--muted);
    max-width: 60ch;
  }
  .barra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-block: 1px solid var(--line);
    padding-block: 12px;
  }
  .meta {
    margin: 0;
  }
  .meta strong {
    color: var(--fg);
  }
  .compartir {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .redondo {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid #3a3a40;
    background: transparent;
    color: var(--fg);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .redondo:hover {
    border-color: var(--azul);
    color: var(--azul);
  }
  .copiado {
    font-size: 13px;
    color: var(--azul);
  }
  .portada {
    aspect-ratio: 16 / 9;
    border-radius: 4px;
  }

  .cuerpo-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
    align-items: flex-start;
    padding-block: 48px 72px;
  }
  .cuerpo {
    flex: 999 1 560px;
    min-width: 0;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .lateral {
    flex: 1 1 300px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .lateral-bloque {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .lateral-titulo {
    margin: 0;
    font-size: 26px;
    color: var(--azul);
    transform: rotate(-2deg);
    transform-origin: left;
  }

  /* Texto de la nota (viene de Keystatic como Markdoc) */
  .prosa {
    display: flex;
    flex-direction: column;
    gap: 24px;
    font-size: 19px;
    line-height: 1.7;
    color: #d6d6da;
  }
  .prosa :global(> *) {
    margin: 0;
  }
  .prosa :global(h2) {
    font-family: var(--f-display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: 36px;
    line-height: 1.05;
    color: var(--fg);
    margin-top: 12px;
  }
  .prosa :global(h3) {
    font-size: 22px;
    color: var(--fg);
  }
  .prosa :global(a) {
    color: var(--azul);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prosa :global(strong) {
    color: var(--fg);
  }
  /* Citas: esténcil sobre cemento */
  .prosa :global(blockquote) {
    margin: 12px 0;
    padding: 40px 32px;
    background-color: #2a2a2d;
    background-image:
      radial-gradient(ellipse at 10% 10%, rgb(255 255 255 / 0.08), transparent 50%),
      radial-gradient(ellipse at 90% 90%, rgb(0 0 0 / 0.4), transparent 55%),
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.025) 0 1px, transparent 1px 6px),
      repeating-linear-gradient(0deg, rgb(0 0 0 / 0.2) 0 1px, transparent 1px 5px);
    font-family: var(--f-display);
    text-transform: uppercase;
    font-size: clamp(30px, 4.5vw, 44px);
    line-height: 1.04;
    letter-spacing: 0.03em;
    color: var(--fg);
    border-bottom: 6px solid var(--azul);
  }
  .prosa :global(blockquote p) {
    margin: 0;
  }
  .prosa :global(ol),
  .prosa :global(ul) {
    padding-left: 0;
    list-style: none;
    counter-reset: item;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
    column-gap: 32px;
  }
  .prosa :global(li) {
    counter-increment: item;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    font-size: 17px;
  }
  .prosa :global(ol li::before) {
    content: counter(item, decimal-leading-zero);
    font-family: var(--f-display);
    color: var(--azul);
    display: inline-block;
    width: 34px;
    font-variant-numeric: tabular-nums;
  }
  .prosa :global(ul li::before) {
    content: '/';
    color: var(--azul);
    font-weight: 700;
    display: inline-block;
    width: 20px;
  }

  .galeria {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .galeria figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .galeria figcaption {
    font-size: 14px;
    color: var(--dim);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .seguir {
    border-top: 1px solid var(--line);
  }
  .seguir-interior {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding-block: 64px 80px;
  }
  .grilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 32px;
  }
</style>
